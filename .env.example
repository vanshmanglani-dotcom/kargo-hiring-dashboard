# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API). Use the service_role key — it is only ever used server-side.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (aistudio.google.com → API key). Use a key on a billing-enabled project so CV data is not used for training.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Resend (resend.com → API Keys). Leave blank until checkpoint B-2.
RESEND_API_KEY=
RESEND_FROM=Kargo Hiring <onboarding@resend.dev>
# Safety rail: only these recipient domains can receive email (comma-separated, * = any)
ALLOWED_RECIPIENT_DOMAINS=pg27.mesaschool.co
# Optional: send EVERY email to this one inbox instead (useful on Resend's free tier, which only
# delivers to your own address until you verify a domain)
TEST_RECIPIENT_OVERRIDE=

# How many candidates per role get a brief + interview invite
SHORTLIST_SIZE=5
FOUNDER_NAME=Arjun Mehta
